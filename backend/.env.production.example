# ============================================================================
# BusPerú · backend · PLANTILLA DE PRODUCCIÓN (sin valores reales)
# ----------------------------------------------------------------------------
# Referencia completa: PRODUCCION.md. Con NODE_ENV=production el proceso NO arranca
# si falta una variable obligatoria o tiene un valor inseguro (config/production-guard.ts
# y config/secrets-guard.ts). Nunca subas el archivo real al repositorio.
# Lo recomendable es inyectar estas variables desde el gestor de secretos del despliegue.
# ============================================================================

NODE_ENV=production
PORT=3000

# --- Base de datos (obligatorias) --------------------------------------------
# Usuario DEDICADO con privilegios mínimos (SELECT, INSERT, UPDATE, DELETE); nunca root.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Sesión (obligatoria) ----------------------------------------------------
# >= 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Frontend y proxy (obligatorias) -----------------------------------------
# Origen https público del frontend: único origen admitido por CORS.
FRONTEND_URL=
# false sin proxy delante; 1..10 = número de proxies de confianza; o lista de IPs/CIDR.
# `true` no se admite. Debe coincidir con la topología real.
TRUST_PROXY=

# --- Correo (obligatorio: resend o smtp) -------------------------------------
MAIL_TRANSPORT=resend
RESEND_API_KEY=
# Remitente de un dominio VERIFICADO en Resend. onboarding@resend.dev se rechaza.
RESEND_FROM_EMAIL=
# Con MAIL_TRANSPORT=smtp, en su lugar:
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=

# --- Culqi (opcional: sin llaves, el pago con tarjeta queda deshabilitado) ---
# Si se define una llave, las tres son obligatorias y del mismo entorno (test o live).
CULQI_PUBLIC_KEY=
CULQI_PRIVATE_KEY=
# >= 32 caracteres aleatorios. Webhook: https://<backend>/api/culqi/webhook/<secreto>
CULQI_WEBHOOK_SECRET=
CULQI_TIMEOUT_MS=20000

# --- OAuth (opcional: sin client id y secret, el proveedor queda desactivado) -
# Si se habilita un proveedor, OAUTH_CALLBACK_BASE_URL es obligatoria y https.
OAUTH_CALLBACK_BASE_URL=
OAUTH_FRONTEND_CALLBACK_PATH=/auth/oauth/callback
OAUTH_STATE_TTL_SECONDS=600
OAUTH_TICKET_TTL_SECONDS=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# PROHIBIDAS en producción (solo para proveedores de prueba):
# GOOGLE_ISSUER, GOOGLE_AUTH_URL, GOOGLE_TOKEN_URL, GOOGLE_JWKS_URI,
# MICROSOFT_ISSUER, MICROSOFT_AUTH_URL, MICROSOFT_TOKEN_URL, MICROSOFT_JWKS_URI

# --- Integraciones por empresa (opcional) ------------------------------------
# 32 bytes en base64 (44 caracteres) o hex (64). Sin ella, el módulo responde 503.
INTEGRATIONS_ENCRYPTION_KEY=
# Solo durante una rotacion de clave: la clave ANTERIOR, que se usa unicamente para
# descifrar lo ya guardado. Todo lo que se escriba usa la de arriba. Se retira cuando no
# quede nada cifrado con la anterior. Vacia el resto del tiempo.
INTEGRATIONS_ENCRYPTION_KEY_PREVIOUS=

# --- Operación ---------------------------------------------------------------
# Directorio PRIVADO y persistente para documentos; incluirlo en los backups.
STORAGE_DIR=storage
BOOKING_EXPIRY_INTERVAL_MS=60000
# Rate limit en MEMORIA: válido con una sola instancia (ver PRODUCCION.md §4).
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=20
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_TICKET_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=45
