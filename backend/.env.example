PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
# Desarrollo local: SIEMPRE la base de pruebas. Fuera de NODE_ENV=production el backend
# se niega a arrancar si DB_NAME no termina en _test (busperu es la base real).
DB_NAME=busperu_test
DB_USER=root
DB_PASSWORD=

# En NODE_ENV=production: al menos 32 caracteres aleatorios (10 distintos como minimo) o el
# proceso no arranca. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:5173

# Proxies de confianza delante de la API (F15-05). Vacío o false = no se confía en
# X-Forwarded-For (lo correcto en local). 1..10 = número de proxies; o lista de IPs/CIDR.
# `true` no se admite. En producción es obligatoria: ver PRODUCCION.md.
TRUST_PROXY=

# Cada cuánto (ms) se revisan las reservas PENDING vencidas
BOOKING_EXPIRY_INTERVAL_MS=60000

# --- Rate limiting -----------------------------------------------------------
# Peticiones por minuto sobre toda la API
RATE_LIMIT_GLOBAL=300
# Intentos por ventana de 15 minutos sobre /api/auth
RATE_LIMIT_AUTH=20

# --- Correo ------------------------------------------------------------------
# log    = imprime el correo en consola (SOLO desarrollo; en producción el proceso no arranca)
# smtp   = envío real con las variables MAIL_* de abajo
# resend = envío real con RESEND_API_KEY y RESEND_FROM_EMAIL (sección Resend)
MAIL_TRANSPORT=log
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=BusPeru <no-reply@busperu.com>

# --- Recuperación de contraseña ----------------------------------------------
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_TICKET_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=45

# --- Almacenamiento de documentos --------------------------------------------
# Directorio PRIVADO (relativo a backend/) donde se guardan los documentos de
# verificación. Nunca debe apuntar a una carpeta servida estáticamente ni al frontend.
STORAGE_DIR=storage

# --- OAuth: Google / Microsoft (PENDIENTES.md §2) -----------------------------
# Flujo Authorization Code + PKCE. Un proveedor SIN client id y secret queda
# desactivado: el backend responde 503 y el frontend no muestra su botón.
# NUNCA pongas estos secretos en el frontend ni los subas al repositorio.
#
# En la consola del proveedor hay que registrar como redirect URI EXACTAMENTE:
#   <OAUTH_CALLBACK_BASE_URL>/auth/oauth/google/callback
#   <OAUTH_CALLBACK_BASE_URL>/auth/oauth/microsoft/callback
OAUTH_CALLBACK_BASE_URL=http://localhost:3000/api
OAUTH_FRONTEND_CALLBACK_PATH=/auth/oauth/callback
OAUTH_STATE_TTL_SECONDS=600
OAUTH_TICKET_TTL_SECONDS=60

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# `common` acepta cualquier tenant; un GUID restringe el acceso a esa organización.
MICROSOFT_TENANT=common

# Extremos del proveedor. Se dejan VACÍOS en producción: sin ellos se usan los
# reales de Google y Microsoft. Solo existen para apuntar a un proveedor de
# prueba en un entorno de integración.
# GOOGLE_ISSUER=
# GOOGLE_AUTH_URL=
# GOOGLE_TOKEN_URL=
# GOOGLE_JWKS_URI=
# MICROSOFT_ISSUER=
# MICROSOFT_AUTH_URL=
# MICROSOFT_TOKEN_URL=
# MICROSOFT_JWKS_URI=

# Estado efímero del flujo OAuth: vive en la tabla `oauth_flows` (migración 008), no en
# memoria, de modo que el despliegue admite reinicios, varias instancias y balanceador.
# Los TTL de arriba (OAUTH_STATE_TTL_SECONDS / OAUTH_TICKET_TTL_SECONDS) los gobiernan.

# --- Integraciones por empresa (PENDIENTES.md §5) -----------------------------
# Cifra en reposo las credenciales de integraciones con AES-256-GCM.
# 32 bytes exactos, en base64 o hex. Independiente de JWT_SECRET: rotar el JWT no
# debe inutilizar las credenciales guardadas.
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sin esta clave el módulo responde 503 y NO guarda nada en texto plano.
# En NODE_ENV=production, si se define con otro formato el proceso no arranca.
INTEGRATIONS_ENCRYPTION_KEY=

# --- Resend (correo transaccional) -----------------------------------------
# Pega aqui tu clave de Resend, despues del signo =. Nunca se sube al repositorio:
# backend/.env esta en .gitignore. Solo la lee el backend; jamas el frontend.
RESEND_API_KEY=
# Remitente de desarrollo permitido por Resend sin dominio verificado. En producción es
# obligatorio definir uno de un dominio propio verificado: resend.dev se rechaza al arrancar.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Pon MAIL_TRANSPORT=resend para que el correo salga de verdad por Resend.

# --- Culqi (pasarela de pago) ----------------------------------------------
# Modelo AGREGADOR: cobra BusPeru con UNA cuenta de plataforma y liquida despues a
# cada empresa. Pega aqui tus llaves de DESARROLLO de CulqiPanel (pk_test_ / sk_test_).
# La privada NO sale nunca del backend. La publica si viaja al navegador: la necesita
# Culqi para tokenizar la tarjeta sin que los datos pasen por BusPeru.
CULQI_PUBLIC_KEY=
CULQI_PRIVATE_KEY=
# Segmento secreto de la URL del webhook que registraras en CulqiPanel:
#   https://<dominio-del-backend>/api/culqi/webhook/<CULQI_WEBHOOK_SECRET>
# Culqi no publica un esquema de firma, asi que este valor lo eliges tu (largo y aleatorio).
CULQI_WEBHOOK_SECRET=
# Base de la API v2 de Culqi. Solo se cambia para apuntar a un doble de pruebas.
CULQI_API_URL=https://api.culqi.com/v2
# Milisegundos antes de cortar una llamada a Culqi (un cobro no puede quedarse colgado).
CULQI_TIMEOUT_MS=20000
