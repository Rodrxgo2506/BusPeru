{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CrearRolesSoloConLimite",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::{{ACCOUNT_ID}}:role/busperu-prod-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::{{ACCOUNT_ID}}:policy/busperu/BusPeruProdWorkloadBoundary"
        }
      }
    },
    {
      "Sid": "SoloLaPoliticaGestionadaDeDlm",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::{{ACCOUNT_ID}}:role/busperu-prod-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::{{ACCOUNT_ID}}:policy/busperu/BusPeruProdWorkloadBoundary"
        },
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSDataLifecycleManagerServiceRole"
        }
      }
    },
    {
      "Sid": "GestionarRolesDeLaPila",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:DeleteRole"
      ],
      "Resource": "arn:aws:iam::{{ACCOUNT_ID}}:role/busperu-prod-*"
    },
    {
      "Sid": "PerfilDeInstanciaDeLaPila",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile"
      ],
      "Resource": "arn:aws:iam::{{ACCOUNT_ID}}:instance-profile/busperu-prod-*"
    },
    {
      "Sid": "ListarRolesYPerfiles",
      "Effect": "Allow",
      "Action": [
        "iam:ListRoles",
        "iam:ListInstanceProfiles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PasarRolDeLaAppSoloAEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::{{ACCOUNT_ID}}:role/busperu-prod-app-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PasarRolDeDlmSoloADlm",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::{{ACCOUNT_ID}}:role/busperu-prod-DlmRole-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "dlm.amazonaws.com"
        }
      }
    },
    {
      "Sid": "RolesVinculadosDeElbYRds",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::{{ACCOUNT_ID}}:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "elasticloadbalancing.amazonaws.com",
            "rds.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "AmiPublicaDeAmazonLinux",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameters",
        "ssm:GetParameter"
      ],
      "Resource": "arn:aws:ssm:sa-east-1::parameter/aws/service/ami-amazon-linux-latest/*"
    },
    {
      "Sid": "SecretoMaestroQueCreaRds",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:TagResource",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:sa-east-1:{{ACCOUNT_ID}}:secret:rds!db-*"
    },
    {
      "Sid": "ClaveDeLaBaseSoloViaRds",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:CreateGrant",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:ReEncrypt*"
      ],
      "Resource": "arn:aws:kms:sa-east-1:{{ACCOUNT_ID}}:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "rds.sa-east-1.amazonaws.com"
        },
        "ForAnyValue:StringEquals": {
          "kms:ResourceAliases": [
            "alias/busperu-prod-rds"
          ]
        }
      }
    }
  ]
}
