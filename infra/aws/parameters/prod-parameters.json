{
  "descripcion": "BusPeru · F18-18 · estructura de Parameter Store de PRODUCCION. SIN VALORES. La lee infra/aws/scripts/prod-parameters.mjs. 'origen': generado = se crea aleatorio con prod-parameters.mjs generar (en CloudShell, nunca en un equipo personal); propietario = lo carga el propietario en su terminal (proveedor externo); pila = sale de una salida de CloudFormation; fijo = valor no secreto conocido.",
  "region": "sa-east-1",
  "prefijo": "/busperu/prod/",
  "claves": { "secretos": "alias/busperu-prod-secrets", "datos": "alias/busperu-prod-data" },
  "parametros": [
    { "nombre": "app/PORT", "tipo": "String", "requerido": true, "origen": "fijo", "valor": "3000" },
    { "nombre": "app/DB_HOST", "tipo": "String", "requerido": true, "origen": "pila", "salida": "busperu-prod.DatabaseEndpoint" },
    { "nombre": "app/DB_PORT", "tipo": "String", "requerido": true, "origen": "fijo", "valor": "3306" },
    { "nombre": "app/DB_NAME", "tipo": "String", "requerido": true, "origen": "fijo", "valor": "busperu_prod" },
    { "nombre": "app/DB_USER", "tipo": "String", "requerido": true, "origen": "fijo", "valor": "busperu_app" },
    { "nombre": "app/DB_PASSWORD", "tipo": "SecureString", "clave": "secretos", "requerido": true, "origen": "generado", "formato": "db" },
    { "nombre": "app/JWT_SECRET", "tipo": "SecureString", "clave": "secretos", "requerido": true, "origen": "generado", "formato": "jwt", "nota": "nuevo; nunca el de staging. Sustituirlo cierra todas las sesiones" },
    { "nombre": "app/JWT_EXPIRES_IN", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "8h" },
    { "nombre": "app/FRONTEND_URL", "tipo": "String", "requerido": true, "origen": "pila", "salida": "busperu-prod-web.WebUrl" },
    { "nombre": "app/TRUST_PROXY", "tipo": "String", "requerido": true, "origen": "fijo", "valor": "2", "nota": "visitante → CloudFront → ALB → API: 2 saltos, igual que staging" },
    { "nombre": "app/STORAGE_DIR", "tipo": "String", "requerido": true, "origen": "fijo", "valor": "/data/busperu/storage" },
    { "nombre": "app/MAIL_TRANSPORT", "tipo": "String", "requerido": true, "origen": "fijo", "valor": "resend" },
    { "nombre": "app/RESEND_API_KEY", "tipo": "SecureString", "clave": "secretos", "requerido": true, "origen": "propietario", "nota": "B-03: dominio de envío verificado en Resend" },
    { "nombre": "app/RESEND_FROM_EMAIL", "tipo": "String", "requerido": true, "origen": "fijo", "valor": "soporte@busperuonline.pe" },
    { "nombre": "app/INTEGRATIONS_ENCRYPTION_KEY", "tipo": "SecureString", "clave": "datos", "requerido": true, "origen": "generado", "formato": "clave32", "nota": "obligatoria desde 019 (datos bancarios cifrados). Copia fuera de línea custodiada por el propietario ANTES de usarla" },
    { "nombre": "app/CULQI_PUBLIC_KEY", "tipo": "String", "requerido": false, "origen": "propietario", "nota": "B-04; va junto con las otras dos llaves (el guard exige el trío y el mismo modo)" },
    { "nombre": "app/CULQI_PRIVATE_KEY", "tipo": "SecureString", "clave": "secretos", "requerido": false, "origen": "propietario", "nota": "B-04" },
    { "nombre": "app/CULQI_WEBHOOK_SECRET", "tipo": "SecureString", "clave": "secretos", "requerido": false, "origen": "generado", "formato": "hex32", "nota": "segmento secreto de la URL del webhook; se registra en el panel de Culqi" },
    { "nombre": "app/OAUTH_CALLBACK_BASE_URL", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "https://api.busperuonline.pe/api", "nota": "solo si se activa OAuth" },
    { "nombre": "app/GOOGLE_CLIENT_ID", "tipo": "String", "requerido": false, "origen": "propietario" },
    { "nombre": "app/GOOGLE_CLIENT_SECRET", "tipo": "SecureString", "clave": "secretos", "requerido": false, "origen": "propietario" },
    { "nombre": "app/MICROSOFT_CLIENT_ID", "tipo": "String", "requerido": false, "origen": "propietario" },
    { "nombre": "app/MICROSOFT_CLIENT_SECRET", "tipo": "SecureString", "clave": "secretos", "requerido": false, "origen": "propietario" },
    { "nombre": "app/INTEGRATIONS_ENCRYPTION_KEY_PREVIOUS", "tipo": "SecureString", "clave": "datos", "requerido": false, "origen": "propietario", "nota": "solo durante una rotación (runbook §5.2); vacía el resto del tiempo" },
    { "nombre": "app/MICROSOFT_TENANT", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "common" },
    { "nombre": "app/OAUTH_FRONTEND_CALLBACK_PATH", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "/auth/oauth/callback" },
    { "nombre": "app/OAUTH_STATE_TTL_SECONDS", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "600" },
    { "nombre": "app/OAUTH_TICKET_TTL_SECONDS", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "60" },
    { "nombre": "app/CULQI_TIMEOUT_MS", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "20000" },
    { "nombre": "app/BOOKING_EXPIRY_INTERVAL_MS", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "60000" },
    { "nombre": "app/RATE_LIMIT_GLOBAL", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "300", "nota": "en memoria: válido con UNA instancia" },
    { "nombre": "app/RATE_LIMIT_AUTH", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "20", "nota": "en memoria: válido con UNA instancia" },
    { "nombre": "app/PASSWORD_RESET_CODE_TTL_MINUTES", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "15" },
    { "nombre": "app/PASSWORD_RESET_TICKET_TTL_MINUTES", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "10" },
    { "nombre": "app/PASSWORD_RESET_MAX_ATTEMPTS", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "5" },
    { "nombre": "app/PASSWORD_RESET_RESEND_COOLDOWN_SECONDS", "tipo": "String", "requerido": false, "origen": "fijo", "valor": "45" },
    { "nombre": "ops/MIGRATOR_DB_PASSWORD", "tipo": "SecureString", "clave": "secretos", "requerido": true, "origen": "generado", "formato": "db", "nota": "solo lo lee la instancia para migrar; la API no lo recibe" },
    { "nombre": "ops/CLOUDFRONT_ORIGIN_SECRET", "tipo": "SecureString", "clave": "secretos", "requerido": true, "origen": "generado", "formato": "hex32", "nota": "OriginVerifySecret de busperu-prod y busperu-prod-web (mismo valor en las dos)" },
    { "nombre": "ops/ADMIN_EMAIL", "tipo": "String", "requerido": false, "origen": "propietario", "nota": "primer administrador (admin:bootstrap)" },
    { "nombre": "ops/ADMIN_PASSWORD", "tipo": "SecureString", "clave": "secretos", "requerido": false, "origen": "generado", "formato": "db", "nota": "temporal: se cambia en el primer inicio de sesión y se borra el parámetro" }
  ],
  "prohibidos": [
    "app/GOOGLE_ISSUER", "app/GOOGLE_AUTH_URL", "app/GOOGLE_TOKEN_URL", "app/GOOGLE_JWKS_URI",
    "app/MICROSOFT_ISSUER", "app/MICROSOFT_AUTH_URL", "app/MICROSOFT_TOKEN_URL", "app/MICROSOFT_JWKS_URI",
    "app/NODE_ENV", "app/MAIL_PASSWORD"
  ]
}
